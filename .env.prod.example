# =============================================================================
# Template for the production environment file.
#
#   cp .env.prod.example .env.prod     (Windows: copy .env.prod.example .env.prod)
#
# then fill in the real values. `.env.prod` is git-ignored and must NEVER be
# committed. This template holds placeholders only.
#
# The file is used twice by docker-compose.prod.yml:
#   * `--env-file .env.prod` on the command line -> fills the ${...} slots in
#     the compose file itself (database credentials, frontend path, Vite args)
#   * `env_file: .env.prod` on the services      -> hands these variables to
#     the backend container, where pydantic-settings reads them
#
# GOTCHA: compose expands `$` during interpolation. If a password contains a
# literal `$`, double it (`pa$$word` for `pa$word`) or avoid `$` entirely.
# =============================================================================


# --- 1. DATABASE -------------------------------------------------------------
# The compose file assembles DATABASE_URL from these three, so there is only
# one place to change a credential. Do not set DATABASE_URL here — the compose
# file's `environment:` block would override it anyway.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-real-password
POSTGRES_DB=fitpass_db


# --- 2. SECURITY (required — the app refuses to start without it) ------------
# Signs the JWT inside the HttpOnly auth cookie. Anyone holding this value can
# forge a session for any user, including an admin. Generate a fresh one:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Rotating it instantly logs everybody out, which is the intended behaviour.
SECRET_KEY=generate-a-long-random-value-do-not-reuse-the-dev-one

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30


# --- 3. WHERE THE APP IS REACHED ---------------------------------------------
# Used for the links inside verification / password-reset emails, and to build
# CORS_ORIGINS. Must match what users actually type in the browser.
#
# !!! HTTPS WARNING !!!
# The login cookie is created with Secure=True (app/api/users.py), meaning the
# browser only stores it on a secure origin. `http://localhost` counts as one
# by special exception, so the local demo works. `http://192.168.x.x` or
# `http://yourdomain.com` do NOT — the browser silently discards the cookie and
# every login appears to succeed and then immediately log the user out.
# For a real deployment: terminate TLS in Nginx and set this to https://...
FRONTEND_URL=http://localhost


# --- 4. STRIPE ---------------------------------------------------------------
# Use live keys only for a real deployment; sk_test_/whsec_test are for demos.
# The webhook secret must match the endpoint you registered in the Stripe
# dashboard, pointing at https://<your-host>/api/payments/webhook
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=


# --- 5. EMAIL ----------------------------------------------------------------
# Either a Resend API key, or SMTP credentials — the app picks whichever is
# configured. Leave everything blank to run without outgoing email (account
# verification links will then have to be read from the backend logs).
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=FitPass
RESEND_API_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=


# --- 6. reCAPTCHA ------------------------------------------------------------
# FEATURE_RECAPTCHA + RECAPTCHA_SECRET are the backend half (verifies tokens).
# VITE_* are the frontend half; compose passes them to the Vite build as build
# args, because Vite bakes them into the bundle and cannot read them at runtime.
# Both halves must agree, and the site key must be the public pair of the secret.
FEATURE_RECAPTCHA=false
RECAPTCHA_SECRET=

VITE_FEATURE_RECAPTCHA=false
VITE_RECAPTCHA_SITE_KEY=


# --- 7. MISC -----------------------------------------------------------------
# Every timestamp is stored in UTC; this is the zone admins read times in.
GYM_TIMEZONE=Europe/Belgrade


# --- 8. WHERE THE FRONTEND REPOSITORY LIVES ----------------------------------
# The frontend is a separate git repo, not a subfolder of this one, so compose
# needs an explicit path to its build context. Absolute paths are fine and are
# the safer choice. Leave it commented out to use the default baked into
# docker-compose.prod.yml.
#FRONTEND_PATH=D:/Front-End projekti/fitpass-clone-frontend
